PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/invitaizen?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_NAME=unio_session
# Password given to every seeded demo account (local/hackathon use only)
SEED_DEMO_PASSWORD=
# Password for `npm run create-reviewer -- <email>` (verification reviewers)
REVIEWER_PASSWORD=
# AI Brief Builder (optional). Without a key, "Create with AI" returns a labelled template draft.
# Server-side only: never put this in a VITE_* variable.
ANTHROPIC_API_KEY=
BRIEF_AI_MODEL=claude-opus-5-5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
